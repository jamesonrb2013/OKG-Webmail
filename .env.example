# Copy these into your hosting provider's environment settings.
# Use separate random values; do not commit real secrets.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
ENCRYPTION_KEY=replace-with-a-different-random-secret-at-least-32-characters
REGISTRATION_CODE=share-a-private-invite-code-with-staff
DATA_DIR=/data
NODE_ENV=production
PORT=3000
